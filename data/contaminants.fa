# ============================================================
# Large genome spike-ins — download and append as needed
# ============================================================
# Lambda phage (Enterobacteria phage lambda, 48 502 bp, NC_001416):
#   echo "# source: LambdaPhage" >> data/contaminants.fa
#   efetch -db nuccore -id NC_001416 -format fasta >> data/contaminants.fa
#
# MS2 RNA phage (Escherichia phage MS2, 3 569 bp, NC_001417):
#   echo "# source: MS2_phage" >> data/contaminants.fa
#   efetch -db nuccore -id NC_001417 -format fasta >> data/contaminants.fa
#
# Mycoplasma pneumoniae (cell culture contaminant, 816 394 bp, NC_000912):
#   echo "# source: Mycoplasma_pneumoniae" >> data/contaminants.fa
#   efetch -db nuccore -id NC_000912 -format fasta >> data/contaminants.fa
#
# Human mitochondrial genome (rCRS, 16 569 bp, NC_012920):
#   echo "# source: Human_mtDNA" >> data/contaminants.fa
#   efetch -db nuccore -id NC_012920 -format fasta >> data/contaminants.fa
#
# (Requires NCBI Entrez Direct: https://www.ncbi.nlm.nih.gov/books/NBK179288/)
# ============================================================


